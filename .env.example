NODE_ENV=production
APP_ENV=production
# Temporary dual-read migration control. Use strict only after backfill verification.
MEMBERSHIP_ENFORCEMENT_MODE=compatibility
PORT=
HOST=
FIREBASE_PROJECT_ID=grounded-fruitful
FIREBASE_STORAGE_BUCKET=grounded-fruitful.firebasestorage.app
# Local path to an untracked service-account JSON file. On Render, create this
# as a secret file and set the variable to that file's mounted path.
GOOGLE_APPLICATION_CREDENTIALS=
ALLOWED_ORIGINS=https://groundedandfruitful.netlify.app
CHILD_LOGIN_PEPPER=
LOG_LEVEL=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
