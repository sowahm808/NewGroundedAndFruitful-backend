NODE_ENV=production
APP_ENV=production
# Temporary dual-read migration control. Use strict only after backfill verification.
MEMBERSHIP_ENFORCEMENT_MODE=compatibility
PORT=
HOST=
FIREBASE_PROJECT_ID=grounded-fruitful
FIREBASE_STORAGE_BUCKET=grounded-fruitful.firebasestorage.app
# Required together in production. Preserve escaped newlines (\n) in the
# private key value; src/config/firebase.ts converts them at startup.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ALLOWED_ORIGINS=https://groundedandfruitful.netlify.app
CHILD_LOGIN_PEPPER=
# Independent random secret; do not reuse the PIN pepper.
CHILD_LOGIN_LOOKUP_SECRET=
# Keep compatibility until every legacy credential copy has been verified.
CHILD_CREDENTIAL_MIGRATION_MODE=compatibility
LOG_LEVEL=
# IANA timezone used for quarter-relative calendar calculations.
PROGRAM_TIMEZONE=UTC
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_STORAGE_EMULATOR_HOST=
