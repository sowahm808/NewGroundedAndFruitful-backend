rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // The web application uses Express APIs. All domain data is server-only;
    // claims can never independently grant organization or relationship scope.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
